// KOOMPI installer — package manifest (Zig 0.14.x).
//
// No dependencies: vaxis was imported but never actually wired to any rendering
// (confirmed dead import) and its only pinned version needs Zig >=0.16, which
// breaks archinstall.zig/cidata.zig's pre-Writergate stdlib usage on this
// toolchain. Rendering is direct ANSI (see main.zig) instead — no fetch, no
// version coupling. See .work/P3-report.md for the full reasoning.
.{
    // Zig 0.14+ uses the enum-literal name form `.name = .koompi_installer`
    // plus a required `.fingerprint` field. (Pre-0.14 / 0.13.x used a quoted
    // string `.name = "koompi_installer"` with no fingerprint; if you ever pin
    // an older toolchain, switch both.)
    .name = .koompi_installer,
    .fingerprint = 0x07b1b58585e0597d,
    .version = "0.0.0-scaffold",
    .minimum_zig_version = "0.14.0",

    .dependencies = .{},

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "README.md",
    },
}
