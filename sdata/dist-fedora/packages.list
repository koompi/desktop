# Fedora packages for the KOOMPI desktop, one per line. Blank lines and
# #-comments are ignored. Read by sdata/dist-fedora/install-deps.sh.
#
# Verified against Fedora 44 (releases + updates) and the COPRs enabled by the
# recipe. The COPR that carries each non-Fedora package is noted inline.

# --- basic -------------------------------------------------------------------
bc
coreutils
cliphist
cmake
curl
wget2-wget
ripgrep
fd-find
jq
xdg-user-dirs
xdg-utils                       # every "open this" in the shell ends at xdg-open
psmisc                          # killall, used by killDialog.qml and the keyring scripts
rsync
git
yq                              # Fedora's yq IS mikefarah/yq, unlike Debian's
fprintd
unzip

# --- audio -------------------------------------------------------------------
cava
pavucontrol-qt
wireplumber
pipewire-pulseaudio
sound-theme-freedesktop
libdbusmenu-gtk3
playerctl

# --- backlight ---------------------------------------------------------------
geoclue2
brightnessctl
ddcutil

# --- fonts and themes --------------------------------------------------------
adw-gtk3-theme
breeze-icon-theme
breeze-gtk-common
breeze-plus-icon-theme          # copr: ririko66z/dots-hyprland
darkly                          # copr: deltacopy/darkly
eza
fish
fontconfig
kitty
matugen
starship                        # copr: atim/starship
florian-karsten-space-grotesk-fonts     # copr: ririko66z/dots-hyprland
jetbrains-mono-nerd-fonts               # copr: ririko66z/dots-hyprland
google-material-symbols-vf-rounded-fonts # copr: ririko66z/dots-hyprland
readex-pro-fonts-all                    # copr: ririko66z/dots-hyprland
google-rubik-vf-fonts                   # copr: ririko66z/dots-hyprland
google-sans-flex-vf-fonts               # copr: ririko66z/dots-hyprland
twitter-twemoji-fonts
bibata-cursor-theme             # copr: ririko66z/dots-hyprland
# fontconfig/fonts.conf names Noto Sans/Serif Khmer as the Khmer fallback by
# name; without them Khmer clips out of any container sized for Latin.
google-noto-sans-khmer-fonts
google-noto-serif-khmer-fonts

# --- KDE apps and integration ------------------------------------------------
dolphin
kdialog
gnome-keyring
libsecret                       # secret-tool, how the keyring scripts reach the Secret Service
NetworkManager
plasma-nm
bluedevil

# --- portals -----------------------------------------------------------------
xdg-desktop-portal
xdg-desktop-portal-gtk
xdg-desktop-portal-hyprland     # copr: sdegler/hyprland

# --- python runtime ----------------------------------------------------------
clang
uv
python3
python3-devel
gtk4-devel
libadwaita-devel
libsoup3-devel
libportal-gtk4
gobject-introspection-devel
python3-gobject
python3-opencv

# --- screen capture ----------------------------------------------------------
hyprshot                        # copr: sdegler/hyprland
grim                            # hyprshot pulls it in, but keybinds.lua calls grim itself
slurp
swappy
tesseract
tesseract-langpack-eng
wf-recorder
libnotify                       # notify-send, the scripts' only way to reach the user

# --- input toolkit -----------------------------------------------------------
upower
power-profiles-daemon           # what the power profile quick toggle switches
wtype
ydotool
# Khmer input. KOOMPI is a Cambodian desktop; the shell's own UI stays English.
# fcitx5 ships its own XDG autostart and exports XMODIFIERS itself.
fcitx5
fcitx5-configtool
fcitx5-gtk
fcitx5-qt
fcitx5-m17n                     # the Khmer keymaps themselves live in m17n
m17n-db

# --- widgets and helpers -----------------------------------------------------
fuzzel
glib2
ImageMagick
hypridle                        # copr: sdegler/hyprland
hyprlock                        # copr: sdegler/hyprland
hyprpicker                      # copr: sdegler/hyprland
songrec                         # copr: ririko66z/dots-hyprland
translate-shell
qalculate
libqalculate
wlogout
ffmpeg-free                     # switchwall.sh, Audio.qml's ffplay, koompi-quicklook
easyeffects                     # the sidebar toggle, started in service mode at login

# --- compositor and shell ----------------------------------------------------
hyprland                        # copr: sdegler/hyprland - 0.56, vs 0.49 in solopasha
hyprsunset                      # copr: sdegler/hyprland
hyprpolkitagent                 # copr: sdegler/hyprland - the graphical auth agent
wl-clipboard
quickshell
qt6ct

# --- optional ----------------------------------------------------------------
microtex                        # copr: ririko66z/dots-hyprland - LaTeX in the shell
zig                             # builds the global-menu daemon
glib2-devel                     # GDBus headers the global-menu daemon links against
pkgconf-pkg-config              # zig build resolves glib through it
xprop                           # the global menu reads menu addresses with it. Fedora 41 split
                                # xorg-x11-utils into one package per binary, so the old name now
                                # resolves to nothing and took xprop down with it silently
xorg-x11-server-Xwayland        # Qt exports its menubar over D-Bus only on X11
