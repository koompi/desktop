groups=(koompi)
pkgname=koompi-microtex-git
_pkgname=MicroTeX
pkgver=r494.0e3707f
pkgrel=4
pkgdesc='MicroTeX for koompi dotfiles.'
#pkgdesc="A dynamic, cross-platform, and embeddable LaTeX rendering library"
arch=("x86_64")
url="https://github.com/NanoMichael/${_pkgname}"
license=('MIT')
depends=(
  tinyxml2
  gtkmm3
  gtksourceviewmm
  cairomm
  fontconfig
)
makedepends=("git" "cmake")
source=(
  "git+${url}.git"
  "microtex-fontconfig-2.18.patch"
)
sha256sums=(
  "SKIP"
  "9bd4105985dbeae3259247c60fc3de9156a0832cc8bc90631da9e37ff948c003"
)

prepare() {
  cd $_pkgname
  patch -Np1 -i "$srcdir/microtex-fontconfig-2.18.patch"
  # Upstream asks pkg-config for gtksourceviewmm-3.0; Arch's gtksourceviewmm
  # ships a newer module name (4.0 today). Use whatever is installed instead of
  # pinning the next name that will break on the bump after it. tinyxml2 needs
  # nothing: CMakeLists finds it through pkg-config too, and the old
  # tinyxml2.so.10 -> .so.11 rewrite matched no line.
  local gsvmm
  gsvmm="$(pkg-config --list-all | awk '$1 ~ /^gtksourceviewmm-[0-9.]+$/ { print $1 }' | sort -V | tail -n1)"
  [[ -n "$gsvmm" ]] || { echo "no gtksourceviewmm-*.pc found; is gtksourceviewmm installed?" >&2; return 1; }
  sed -i "s/gtksourceviewmm-3\.0/$gsvmm/" CMakeLists.txt
}

build() {
  cd $_pkgname
  cmake -B build -S . -DCMAKE_BUILD_TYPE=None
  cmake --build build
}

package() {
  cd $_pkgname
  install -Dm0755 -t "$pkgdir/opt/$_pkgname/" build/LaTeX
  cp -r build/res "$pkgdir/opt/$_pkgname/"
  install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE
}
