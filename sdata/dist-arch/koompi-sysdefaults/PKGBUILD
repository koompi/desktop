# koompi-sysdefaults — system defaults for small machines on school Wi-Fi: swap
# on zram, systemd-oomd that may kill only user app scopes, a 5 s stop timeout,
# and ufw profiles for the two LAN peers the ingress default-deny lets through.
#
# files/ mirrors /. Everything under /usr/lib is a vendor drop-in an admin
# overrides from /etc. The ufw profile has to live in /etc/ufw/applications.d:
# the only directory ufw reads profiles from (config_dir in ufw/common.py).
# sdata/install/setups/system.sh installs the same files for from-git installs.
#
# Enabling is left to the preset, the installer and ./setup; the firewall
# rules themselves are `ufw allow` commands, not files.
groups=(koompi)
pkgname=koompi-sysdefaults
pkgver=1.0
pkgrel=3
pkgdesc='KOOMPI OS system defaults: zram swap, systemd-oomd scoped to apps, 5 s stop timeout, ufw profiles'
arch=(any)
url='https://github.com/koompi/desktop'
license=(GPL-3.0-only)
# zram-generator reads the zram drop-in, ufw the profile; without them the
# files are inert.
depends=(systemd zram-generator ufw)

package() {
  local _src="$startdir/files" _file
  while IFS= read -r -d '' _file; do
    install -Dm644 "$_file" "$pkgdir/${_file#"$_src/"}"
  done < <(find "$_src" -type f -print0)
}
