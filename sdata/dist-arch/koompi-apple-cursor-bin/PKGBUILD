groups=(koompi)
pkgname=koompi-apple-cursor-bin
pkgver=2.0.1
pkgrel=1
pkgdesc="macOS-alike X-cursor theme, the pointer the KOOMPI Otto session runs"
arch=('any')
url="https://github.com/ful1e5/apple_cursor"
license=('GPL-3.0-or-later')
conflicts=("apple_cursor")
options=('!strip')
# The tarball carries macOS and macOS-White; only the dark one is configured.
_variant=macOS
source=("apple-cursor-$pkgver.tar.xz::$url/releases/download/v$pkgver/$_variant.tar.xz")
sha256sums=('9c6e5e13b068ce51a9e90a9abd6ce232ec7d25d4ceb05aa8ac76efbb99c76762')

package() {
  install -dm755 "$pkgdir/usr/share/icons"
  cp -dr --no-preserve=mode $_variant "$pkgdir/usr/share/icons"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
