# koompi-shell — the KOOMPI desktop shell (Quickshell config) and the koompi-*
# command-line tools, installed to package-owned paths.
#
# The shell tree goes to /etc/xdg/quickshell/koompi: quickshell resolves
# `qs -c koompi` from every XDG config dir, user dir first, so a user copy in
# ~/.config/quickshell/koompi (seeded from /etc/skel by koompi-hyprland-config)
# overrides this one and the packaged tree is the always-present fallback.
# The tools go to /usr/bin; ~/.local/bin copies still win via session PATH.
# koompi-migrate syncs existing users' copies up to these defaults.
#
# BUILD NOTE: via the existing sdata/dist-arch flow (plain makepkg in-tree) this
# reads ../../../dots through $startdir. For clean-chroot / repo builds (devtools,
# the koompi pacman repo), that relative tree is absent — switch `source` to a
# pinned git tag of this repo and copy from "$srcdir/koompi-desktop/dots".
groups=(koompi)
pkgname=koompi-shell
pkgver=1.1
pkgrel=4
pkgdesc='KOOMPI desktop shell (Quickshell config) and koompi-* tools'
arch=(x86_64 aarch64)
license=(GPL-3.0-only)
# xorg-xprop and xorg-xwayland are not optional: Qt exports its menubar over
# D-Bus only on X11, so the global menu reads the menu address off XWayland
# window properties with xprop. Without either one the bar is silently empty.
# python-gobject: koompi-remotedesktop-portal is a Python script on Gio/GLib.
depends=(koompi-quickshell-git rsync jq xorg-xprop xorg-xwayland python-gobject)
makedepends=(zig rsync)

# Every dots/.local/bin/koompi-* executable ships, by name, so what the package
# puts in /usr/bin can be read off this file. tests/test_packaged_tools.sh
# fails when this list and the directory disagree in either direction: five
# tools were missing on 2026-08-25 and `koompi hook` / `koompi plugin` failed on
# every KOOMPI OS install (OMARCHY-AUDIT O01). koompi-wallpaper is a symlink
# into the hypr tree in dots/; install(1) follows it, so system-wide it is the
# real script.
_tools=(
  koompi-agent-usage-claude
  koompi-agent-usage-codex
  koompi-agent-usage-pi
  koompi-displays
  koompi-flatpak-open
  koompi-health
  koompi-hook
  koompi-launch
  koompi-launch-webapp
  koompi-lid
  koompi-litert-lm-watchdog
  koompi-logout
  koompi-migrate
  koompi-notify-send
  koompi-plugin
  koompi-quicklook
  koompi-reload
  koompi-remotedesktop-portal
  koompi-settings
  koompi-signature
  koompi-snapshot
  koompi-stacking
  koompi-theme
  koompi-useradd
  koompi-wallpaper
  koompi-webapp-install
  koompi-webapp-remove
  koompi-workbench
)
# Left out on purpose. Each name must still exist in dots/.local/bin, and each
# carries the reason on its own line; the test checks both.
_tools_excluded=(
  koompi-session  # owned by the koompi-session package, same /usr/bin path
  koompi-update   # replaced by the koompi-update -> koompi symlink in package()
)

build() {
  local _repo_root
  _repo_root="$(cd "$startdir/../../.." && pwd)"
  cd "$_repo_root/cli"
  zig build \
    --cache-dir "$srcdir/koompi-cli-cache" \
    --prefix "$srcdir/koompi-cli-out" \
    -Doptimize=ReleaseSafe
}

package() {
  local _repo_root
  _repo_root="$(cd "$startdir/../../.." && pwd)"
  if [[ ! -d "$_repo_root/dots" ]]; then
    echo "koompi-shell: dots/ not found at repo root ($_repo_root)." >&2
    echo "Building in a clean chroot? Switch source to a pinned git tag (see header)." >&2
    return 1
  fi

  # Build artefacts and caches never ship (the list ./setup uses in
  # sdata/install/files.sh): a checkout that has built the global-menu daemon
  # carries hundreds of MB of .zig-cache under the shell tree, gitignored but
  # on disk, and cp -a used to package it (BUG-AUDIT H3).
  local -a _excludes=(
    --exclude='.git' --exclude='.gitignore' --exclude='.claude'
    --exclude='zig-out' --exclude='.zig-cache' --exclude='__pycache__'
    --exclude='*.pyc' --exclude='.qmlls.ini'
  )
  install -dm755 "$pkgdir/etc/xdg/quickshell"
  rsync -a "${_excludes[@]}" "$_repo_root/dots/.config/quickshell/koompi/" \
    "$pkgdir/etc/xdg/quickshell/koompi/"
  # Quick Look is a separate quickshell config, not a panel of the main shell,
  # so a crash in a file preview cannot take the bar down with it.
  rsync -a "${_excludes[@]}" "$_repo_root/dots/.config/quickshell/koompi-quicklook/" \
    "$pkgdir/etc/xdg/quickshell/koompi-quicklook/"

  install -Dm755 "$srcdir/koompi-cli-out/bin/koompi" "$pkgdir/usr/bin/koompi"
  install -Dm755 "$_repo_root/dots/.local/share/koompi/libexec/update" \
    "$pkgdir/usr/lib/koompi/update"
  # update sources this from its own directory and exits if it is missing.
  install -Dm644 "$_repo_root/dots/.local/share/koompi/libexec/update-lib.sh" \
    "$pkgdir/usr/lib/koompi/update-lib.sh"
  ln -s koompi "$pkgdir/usr/bin/koompi-update"

  local tool
  for tool in "${_tools[@]}"; do
    install -Dm755 "$_repo_root/dots/.local/bin/$tool" "$pkgdir/usr/bin/$tool"
  done

  # KDE apps (Dolphin's Open With) need an XDG menu to index applications;
  # Plasma's menu left with the plasma removal.
  install -Dm644 "$_repo_root/dots/.config/menus/applications.menu" \
    "$pkgdir/etc/xdg/menus/applications.menu"

  # koompi-snapshot-boot-check: system-level (not a per-user dotfile, so it
  # lives in files/, not dots/), flags /run/koompi-booted-snapshot at boot so
  # the user koompi-snapshot-notify.service can tell the session about it.
  # Shipped pre-enabled via a sysinit.target.wants symlink in the package
  # tree, matching how the ISO enables its own oneshot units.
  install -Dm644 "$_repo_root/sdata/dist-arch/koompi-shell/files/koompi-snapshot-boot-check.service" \
    "$pkgdir/usr/lib/systemd/system/koompi-snapshot-boot-check.service"
  install -dm755 "$pkgdir/usr/lib/systemd/system/sysinit.target.wants"
  ln -s ../koompi-snapshot-boot-check.service \
    "$pkgdir/usr/lib/systemd/system/sysinit.target.wants/koompi-snapshot-boot-check.service"
}
