groups=(koompi)
pkgname=koompi-basic
pkgver=1.0
pkgrel=6
pkgdesc='KOOMPI Basic Dependencies'
arch=(any)
license=(None)
depends=(
  bc
  coreutils
  cliphist
  cmake
  zig
  curl
  wget
  ripgrep
  fd
  jq
  xdg-user-dirs
  # Every "open this" in the shell and the keybinds ends at xdg-open.
  xdg-utils
  # notify-send: the scripts' only way to say anything to the user.
  libnotify
  # killall, used by killDialog.qml and the keyring unlock script. procps-ng
  # (pidof, pkill) comes with base; psmisc does not.
  psmisc
  # checkupdates, which is the whole of services/Updates.qml on Arch.
  pacman-contrib
  # Used in install script
  rsync
  go-yq # https://github.com/mikefarah/yq
  # Fingerprint login/unlock; lock screen's fprintd.conf needs pam_fprintd. libfprint is pulled in by fprintd.
  fprintd
)
