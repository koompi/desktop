#!/usr/bin/env bash
# koompi-settings - open the KOOMPI settings (control center).
#
# KOOMPI-native: launches the Quickshell settings page directly. No KDE
# systemsettings / GNOME control-center fallback and no forced GNOME identity.
set -euo pipefail

XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
# User config wins; /etc/xdg/quickshell/koompi is the packaged default tree
# (koompi-shell), the same search order quickshell itself uses for `qs -c`.
SHELL_DIR="$XDG_CONFIG_HOME/quickshell/koompi"
[[ -d "$SHELL_DIR" ]] || SHELL_DIR="/etc/xdg/quickshell/koompi"
SETTINGS_QML="${KOOMPI_SETTINGS_QML:-$SHELL_DIR/settings.qml}"

if ! command -v qs >/dev/null 2>&1; then
    echo "koompi-settings: quickshell (qs) not found" >&2
    exit 1
fi
if [[ ! -f "$SETTINGS_QML" ]]; then
    echo "koompi-settings: settings UI not found: $SETTINGS_QML" >&2
    exit 1
fi

# Toggle like the sidebars (Super + I opens, Super + I closes): a bare
# invocation closes the running instance; a page argument switches to it.
if pgrep -f "qs -p $SETTINGS_QML" >/dev/null 2>&1; then
    qs kill -p "$SETTINGS_QML" 2>/dev/null || pkill -f "qs -p $SETTINGS_QML" || true
    [[ $# -ge 1 ]] || exit 0
fi

# Optional page name, e.g. `koompi-settings bluetooth`, matched against the
# settings page component filenames.
if [[ $# -ge 1 ]]; then
    export KOOMPI_SETTINGS_PAGE="$1"
fi

exec qs -p "$SETTINGS_QML"
