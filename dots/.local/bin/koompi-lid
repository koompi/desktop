#!/usr/bin/env bash
# Lid switch handler behind the `switch:on/off:Lid Switch` binds in keybinds.lua.
#
# close: lock the session the moment the lid shuts, unless an external monitor
# is attached, so a docked laptop keeps working with its lid down. The lock is
# the same `loginctl lock-session` the session menu uses (Session.qml), so the
# lock screen and hyprlock fallback are shared. Suspend stays with logind and
# its HandleLidSwitch setting: with Keep awake on, the shell's systemd-inhibit
# blocks handle-lid-switch (services/Idle.qml), and this script never suspends
# on its own, so that inhibitor keeps winning.
# open: nothing. Restoring a clamshell layout is a separate job; the bind is
# here so the hook has one obvious place to grow.
# --closed: a query, exit 0 when the lid is shut. It is the clamshell gate in
# the sudo and polkit PAM stacks koompi-setup-fingerprint writes (pam_exec runs
# it as root with no session, so it reads /proc, never hyprctl).
set -euo pipefail

usage() {
    printf 'usage: koompi-lid close|open|--closed\n' >&2
    exit 2
}

# Internal panels enumerate as eDP-*, LVDS-* or DSI-*; anything else is
# external. An unreadable monitor list is treated as "internal only": a lock
# that was not needed beats a shared laptop left open.
external_monitor_attached() {
    local monitors
    monitors="$(hyprctl monitors -j 2> /dev/null)" || return 1
    jq -e '[.[] | select(.name | test("^(eDP|LVDS|DSI)-") | not)] | length > 0' \
        <<< "$monitors" > /dev/null 2>&1
}

case "${1:-}" in
    close)
        if external_monitor_attached; then
            printf 'koompi-lid: external monitor attached, not locking\n'
            exit 0
        fi
        loginctl lock-session || {
            printf 'koompi-lid: loginctl lock-session failed\n' >&2
            exit 1
        }
        ;;
    open) ;;
    --closed)
        # ACPI reports "state: closed" or "state: open"; no lid switch at all
        # (a desktop) answers open, so the gate never hides the reader there.
        for state in "${KOOMPI_LID_STATE_DIR:-/proc/acpi/button/lid}"/*/state; do
            [[ -r "$state" ]] || continue
            if [[ "$(< "$state")" == *closed* ]]; then
                exit 0
            fi
        done
        exit 1
        ;;
    *) usage ;;
esac
