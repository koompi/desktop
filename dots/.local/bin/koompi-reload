#!/usr/bin/env bash
# Reload the compositor configuration and restart the KOOMPI shell so QML
# changes become visible immediately.
set -euo pipefail

# same lookup as the CLI's updateHelper (cli/src/main.zig:152): XDG_DATA_HOME, HOME, /usr/lib/koompi
lib=""
for candidate in "${XDG_DATA_HOME:+$XDG_DATA_HOME/koompi/libexec/update-lib.sh}" \
                 "${HOME:-}/.local/share/koompi/libexec/update-lib.sh" \
                 /usr/lib/koompi/update-lib.sh; do
    [[ -n "$candidate" && -f "$candidate" ]] && { lib="$candidate"; break; }
done
[[ -n "$lib" ]] || {
    echo "koompi reload: update-lib.sh not found in \${XDG_DATA_HOME}/koompi/libexec, ~/.local/share/koompi/libexec or /usr/lib/koompi; reinstall with ./setup update" >&2
    exit 1
}
# shellcheck source-path=SCRIPTDIR/../share/koompi/libexec
# shellcheck source=update-lib.sh
source "$lib"
DRY_RUN=false

{ [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] && have hyprctl; } || die "no running Hyprland session"

# killing qs under a lock strands the seat on Hyprland's failsafe lock
if session_locked; then
    die "session is locked; unlock and run 'koompi reload'"
fi

run hyprctl reload

if have qs; then
    stop_processes global-menu-daemon qs quickshell
    setsid env QT_QPA_PLATFORM=wayland qs -c koompi >/dev/null 2>&1 &
fi

ok "KOOMPI desktop reloaded"
