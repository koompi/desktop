#!/usr/bin/env bash
set -euo pipefail

file="$1"

case "$file" in
    *.flatpakrepo) flatpak remote-add --user --if-not-exists --from "$file" ;;
    *.flatpak)     flatpak install --user --bundle "$file" ;;
    *)             flatpak install --user --from "$file" ;;
esac

printf '\nPress Enter to close.'
read -r
