#!/usr/bin/env bash
# koompi-otto-session - launch the KOOMPI desktop on the Otto compositor.
#
# The sibling of koompi-session, which launches the Hyprland one. This one only
# sets the session environment: Otto reads ~/.config/otto/config.toml and starts
# its own bar and island from there.
set -euo pipefail

# Session identity. Otto overwrites XDG_CURRENT_DESKTOP with "otto" for its own
# children - that is what selects xdg-desktop-portal-otto - so this is for
# anything reading the environment before Otto starts.
export XDG_CURRENT_DESKTOP="KOOMPI:Otto"
export XDG_SESSION_DESKTOP="KOOMPI"
: "${XDG_SESSION_TYPE:=wayland}"
export XDG_SESSION_TYPE

# Display managers do not put ~/.local/bin on PATH, and everything Otto spawns -
# exec_once, xdg autostart, the dock - inherits this env.
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

compositor="${KOOMPI_OTTO_COMPOSITOR:-/usr/bin/otto}"
if [[ ! -x "$compositor" ]]; then
    echo "koompi-otto-session: $compositor not found or not executable" >&2
    echo "koompi-otto-session: install the 'otto' package" >&2
    exit 1
fi

exec "$compositor" "$@"
