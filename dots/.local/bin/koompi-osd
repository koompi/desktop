#!/usr/bin/env bash
# koompi-osd - one line on the shell's OSD, over Quickshell IPC
# (modules/koompi/onScreenDisplay/OnScreenDisplay.qml, target `osd`).
set -euo pipefail

usage() {
    cat <<'USAGE'
Usage: koompi-osd [-i ICON] [-m TEXT] [-p 0..100] [-d MS]

  -i, --icon ICON      a Material Symbols name: check, battery_alert, ...
  -m, --message TEXT   the line to show
  -p, --progress N     draw a bar at N percent; without it there is no bar
  -d, --duration MS    how long it stays; default is the shell's osd.timeout

At least one of -i and -m is needed.
Exit status: 0 shown, 2 shell not running, 64 usage.
USAGE
}

bad() { echo "koompi-osd: $1" >&2; usage >&2; exit 64; }

icon="" message="" progress=-1 duration=0
while (($#)); do
    case "$1" in
        -h|--help|help) usage; exit 0 ;;
        -i|--icon|-m|--message|-p|--progress|-d|--duration)
            [[ $# -ge 2 ]] || bad "$1 needs a value" ;;&
        -i|--icon) icon="$2"; shift 2 ;;
        -m|--message) message="$2"; shift 2 ;;
        -p|--progress)
            [[ "$2" =~ ^[0-9]+$ && "$2" -le 100 ]] || bad "progress must be 0..100, got '$2'"
            progress="$2"; shift 2 ;;
        -d|--duration)
            [[ "$2" =~ ^[1-9][0-9]*$ ]] || bad "duration must be a positive number of milliseconds, got '$2'"
            duration="$2"; shift 2 ;;
        *) bad "unknown option '$1'" ;;
    esac
done
[[ -n "$icon" || -n "$message" ]] || bad "nothing to show: give -i or -m"

# no instance: qs exit 255; shell older than the handler: "Target not found."
# exit 0, or an argument-count error. -- keeps a message starting with a dash
# out of qs's option parser
rc=0
answer="$(qs -c koompi ipc --any-display call osd show -- "$icon" "$message" "$progress" "$duration")" || rc=$?
if (( rc == 255 )); then
    echo "koompi-osd: the shell is not running" >&2
    exit 2
fi
if (( rc != 0 )) || [[ "$answer" != ok ]]; then
    echo "koompi-osd: no answer from the shell: ${answer:-qs exit $rc} (shell older than this tool?)" >&2
    exit 2
fi
