{
    "label" : "lock",
    "action" : "loginctl lock-session",
    "text" : "lock",
    "keybind" : "l"
}
{
    "label" : "hibernate",
    "action" : "systemctl hibernate || loginctl hibernate",
    "text" : "downloading",
    "keybind" : "h"
}
{
    "label" : "logout",
    "action" : "loginctl terminate-session \"$XDG_SESSION_ID\" || hyprctl dispatch exit",
    "text" : "logout",
    "keybind" : "e"
}
{
    "label" : "shutdown",
    "action" : "hyprctl clients -j | jq -r '.[] | select(.pid > 0) | .pid' | xargs -r kill; systemctl poweroff || loginctl poweroff",
    "text" : "power_settings_new",
    "keybind" : "s"
}
{
    "label" : "suspend",
    "action" : "systemctl suspend || loginctl suspend",
    "text" : "bedtime",
    "keybind" : "u"
}
{
    "label" : "reboot",
    "action" : "hyprctl clients -j | jq -r '.[] | select(.pid > 0) | .pid' | xargs -r kill; systemctl reboot || loginctl reboot",
    "text" : "restart_alt",
    "keybind" : "r"
}
